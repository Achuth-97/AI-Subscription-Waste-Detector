            uploaded_data = pd.read_csv(BytesIO(uploaded_bytes))
            missing = [
                column for column in REQUIRED_COLUMNS
                if column not in uploaded_data.columns
            ]
            if missing:
                st.session_state.upload_error = (
                    "Missing CSV columns: " + ", ".join(missing)
                )
            elif uploaded_data.empty:
                st.session_state.upload_error = (
                    "The uploaded CSV contains no subscription rows."
                )
            else:
                st.session_state.draft_data = uploaded_data
                st.session_state.subscription_data_fingerprint = None
                st.session_state.pop("subscription_editor", None)
                st.success(
                    f"Loaded {len(uploaded_data)} subscription row(s). "
                    "Review or edit the table before analysis."
                )
        except (pd.errors.ParserError, UnicodeDecodeError, ValueError) as error:
            st.session_state.upload_error = f"Could not read the CSV: {error}"
        except OSError as error:
            st.session_state.upload_error = f"Could not access the uploaded file: {error}"
elif (
    st.session_state.upload_signature is not None
    or st.session_state.upload_error is not None
):
    if st.button("Restore sample data", key="restore_sample_data"):
        st.session_state.draft_data = DEFAULT_DATA.copy()
        st.session_state.upload_signature = None
        st.session_state.upload_error = None
        st.session_state.analysis_data = None
        st.session_state.analysis_fingerprint = None
        st.session_state.subscription_data_fingerprint = None
        st.session_state.pop("subscription_editor", None)

upload_error = st.session_state.upload_error
if upload_error:
    st.error(upload_error)

st.markdown('<div class="section-eyebrow">Your data</div>', unsafe_allow_html=True)
st.subheader("Review and edit subscriptions")
st.caption(
    "Costs should be monthly. Usage days must be between 0 and 31. "
    "Edits are kept when you switch between Dashboard and About Project."
)
input_data = st.data_editor(
    st.session_state.draft_data,
    key="subscription_editor",
    num_rows="dynamic",
    width="stretch",
    hide_index=True,
    column_config={
        "subscription_name": st.column_config.TextColumn(
            "Subscription", required=True, width=160
        ),
        "category": st.column_config.TextColumn(
            "Category", required=True, width=145
        ),
        "monthly_cost": st.column_config.NumberColumn(
            "Monthly cost (₹)", min_value=0, width=145
        ),
        "usage_days": st.column_config.NumberColumn(
            "Usage days", min_value=0, max_value=31, width=125
        ),
        "usage_hours": st.column_config.NumberColumn(
            "Usage hours", min_value=0, width=120
        ),
        "months_subscribed": st.column_config.NumberColumn(
            "Months subscribed", min_value=1, width=145
        ),
        "previous_usage_days": st.column_config.NumberColumn(
            "Previous usage days", min_value=0, max_value=31, width=160
        ),
    },
)
st.session_state.draft_data = input_data

current_fingerprint = fingerprint(input_data)
if current_fingerprint != st.session_state.subscription_data_fingerprint:
    try:
        save_subscriptions(st.session_state.auth_user_id, input_data)
    except (OSError, sqlite3.Error, TypeError, ValueError) as error:
        st.error(f"Could not save your subscription data: {error}")
    else:
        st.session_state.subscription_data_fingerprint = current_fingerprint

has_current_analysis = (
    st.session_state.analysis_data is not None
    and st.session_state.analysis_fingerprint == current_fingerprint
)
if st.session_state.analysis_data is not None and not has_current_analysis:
    st.info("Your subscription data changed. Analyze again to refresh the results.")

button_col, note_col = st.columns([1, 1.5], vertical_alignment="center")
with button_col:
    analyze_clicked = st.button(
        "Analyze All Subscriptions",
        type="primary",
        icon=":material/analytics:",
        width="stretch",
        disabled=upload_error is not None,
    )
with note_col:
    st.caption(
        "The Random Forest runs when you analyze or update the data—not on "
        "ordinary page reruns."
    )

if analyze_clicked:
    validated_data, validation_errors = validate_input(input_data)
    if validation_errors:
        for message in validation_errors:
            st.error(message)
    else:
        try:
            with st.spinner("Analyzing subscriptions with the trained Random Forest..."):
                model = load_model()
                model_data = prepare_model_input(validated_data)
                predictions = model.predict(model_data)
                probabilities = model.predict_proba(model_data)[:, 1] * 100

            analyzed_data = validated_data.copy()
            analyzed_data["waste_risk"] = probabilities.round(1)
            analyzed_data["prediction"] = predictions
            analyzed_data["usage_change"] = (
                analyzed_data["usage_days"]
                - analyzed_data["previous_usage_days"]
            )
            analyzed_data["review_cost"] = analyzed_data.apply(
                lambda row: row["monthly_cost"]
                if row["waste_risk"] >= 80
                else 0,
                axis=1,
            )
            st.session_state.analysis_data = analyzed_data
            st.session_state.analysis_fingerprint = fingerprint(input_data)
            st.session_state.pop("cancellation_simulator", None)
            st.success(
                f"Analysis complete for {len(analyzed_data)} subscription(s)."
            )
            has_current_analysis = True
        except (FileNotFoundError, OSError) as error:
            st.error(f"The trained model could not be loaded: {error}")
        except Exception as error:
            st.error(f"Analysis failed: {error}")
            st.info(
                "Check the model file and confirm the data follows the required "
                "columns and numeric ranges."
            )

if has_current_analysis:
    data = st.session_state.analysis_data.copy()
    total_spending = float(data["monthly_cost"].sum())
    review_cost = float(data["review_cost"].sum())
    high_risk = data[data["waste_risk"] >= 80]
    high_risk_count = int(len(high_risk))
    average_risk = float(data["waste_risk"].mean())
    total_monthly_cost = total_spending

    overview_tab, ai_tab, spending_tab, insights_tab, reports_tab = st.tabs(
        ["Overview", "AI Analysis", "Spending & Savings", "Insights", "Reports"]
    )

    with overview_tab:
        st.markdown('<div class="section-eyebrow">At a glance</div>', unsafe_allow_html=True)
        st.subheader("Your subscription snapshot")
        metrics = st.columns(4)
        metrics[0].metric("Monthly spending", f"₹{total_spending:,.0f}")
        metrics[1].metric("Cost flagged to review", f"₹{review_cost:,.0f}")
        metrics[2].metric("High-risk subscriptions", high_risk_count)
        metrics[3].metric("Average estimated risk", f"{average_risk:.1f}%")
        st.caption(
            "Review cost is the full monthly price of subscriptions with estimated "
            "risk at or above 80%; it is not guaranteed savings."
        )
        st.subheader("Subscriptions included")
        render_subscription_icon_list(data)
        left, right = st.columns(2)
        with left:
            st.subheader("Monthly spend by subscription")
            spending_chart = px.bar(
                data,
                x="subscription_name",
                y="monthly_cost",
                color="category",
                labels={
                    "subscription_name": "Subscription",
                    "monthly_cost": "Monthly cost (₹)",
                    "category": "Category",
                },
                color_discrete_sequence=["#2864e8", "#1eb6a5", "#5e82cb", "#81c7c0"],
            )
            spending_chart.update_layout(xaxis_title=None, yaxis_title="Monthly cost (₹)")
            st.plotly_chart(
                style_chart(add_service_icons_to_chart(spending_chart, data)),
                width="stretch",
            )
        with right:
            st.subheader("Spending distribution")
            if total_spending > 0:
                pie_chart = px.pie(
                    data,
                    names="subscription_name",
                    values="monthly_cost",
                    hole=0.58,
                    color_discrete_sequence=["#2864e8", "#1eb6a5", "#5e82cb", "#81c7c0"],
                )
                st.plotly_chart(style_chart(pie_chart), width="stretch")
            else:
                st.info("There is no subscription spending to display.")

    with ai_tab:
        st.markdown('<div class="section-eyebrow">Model results</div>', unsafe_allow_html=True)
        st.subheader("AI subscription analysis")
        st.write(
            "Predictions use the trained Random Forest pipeline and the original "
            "model input features. The risk score is an estimate, not a guaranteed probability."
        )
        render_subscription_icon_list(data, include_risk=True)
        result_data = data.copy()
        result_data["Assessment"] = result_data["prediction"].map(
            {1: "Potentially wasteful — review", 0: "Appears useful"}
        ).fillna(result_data["prediction"].astype(str))
        assessment_view = result_data.rename(
            columns={
                "subscription_name": "Subscription",
                "category": "Category",
                "monthly_cost": "Monthly cost (₹)",
                "usage_days": "Usage days",
                "previous_usage_days": "Previous usage days",
                "waste_risk": "Waste risk (%)",
                "review_cost": "Cost to review (₹)",
                "usage_change": "Usage change (days)",
            }
        )
        st.dataframe(
            assessment_view[
                [
                    "Subscription",
                    "Category",
                    "Monthly cost (₹)",
                    "Usage days",
                    "Previous usage days",
                    "Waste risk (%)",
                    "Assessment",
                    "Cost to review (₹)",
                ]
            ],
            width="stretch",
            hide_index=True,
        )
        risk_chart = px.bar(
            data,
            x="subscription_name",
            y="waste_risk",
            color="waste_risk",
            color_continuous_scale=["#29b78d", "#f3c45d", "#e46c73"],
            range_y=[0, 100],
            labels={
                "subscription_name": "Subscription",
                "waste_risk": "Estimated risk (%)",
            },
        )
        st.plotly_chart(
            style_chart(add_service_icons_to_chart(risk_chart, data)),
            width="stretch",
        )
        st.subheader("Subscriptions requiring review")
        if not high_risk.empty:
            for _, row in high_risk.iterrows():
                st.warning(
                    f"**{row['subscription_name']}** — {row['waste_risk']:.1f}% "
                    f"estimated waste risk; monthly price ₹{row['monthly_cost']:,.0f}. "
                    "Review whether the service is still useful."
                )
        else:
            st.success("No subscriptions crossed the high-risk review threshold.")

    with spending_tab:
        st.markdown('<div class="section-eyebrow">Plan ahead</div>', unsafe_allow_html=True)
        st.subheader("Spending forecast")
        forecast_months = pd.DataFrame(
            {
                "Month": [
                    "Current",
                    "Month 1",
                    "Month 2",
                    "Month 3",
                    "Month 4",
                    "Month 5",
                    "Month 6",
                ],
                "Estimated Spending (₹)": [
                    total_monthly_cost * month for month in range(7)
                ],
            }
        )
        st.metric(
            "Estimated spending over 6 months",
            f"₹{total_monthly_cost * 6:,.0f}",
        )
        forecast_chart = px.line(
            forecast_months,
            x="Month",
            y="Estimated Spending (₹)",
            markers=True,
            color_discrete_sequence=["#2864e8"],
        )
        st.plotly_chart(style_chart(forecast_chart), width="stretch")
        st.info(
            "This baseline assumes all current subscriptions continue at the same "
            "monthly price. It does not predict price changes or future cancellations."
        )

        st.divider()
        st.subheader("Cancellation savings simulator")
        st.write(
            "Select subscriptions to simulate cancelling and estimate potential savings."
        )
        names = data["subscription_name"].astype(str).tolist()
        selected_to_cancel = st.multiselect(
            "Subscriptions to include in the simulation",
            options=names,
            default=[],
            key="cancellation_simulator",
        )
        selected_mask = data["subscription_name"].astype(str).isin(selected_to_cancel)
        monthly_savings = float(data.loc[selected_mask, "monthly_cost"].sum())
        remaining_monthly_cost = max(0, total_monthly_cost - monthly_savings)
        savings_metrics = st.columns(3)
        savings_metrics[0].metric("Current monthly spending", f"₹{total_monthly_cost:,.0f}")
        savings_metrics[1].metric("Potential monthly savings", f"₹{monthly_savings:,.0f}")
        savings_metrics[2].metric("Potential 6-month savings", f"₹{monthly_savings * 6:,.0f}")
        st.write(
            f"**Monthly spending after simulated cancellations:** "
            f"₹{remaining_monthly_cost:,.0f}"
        )
        if selected_to_cancel:
            st.success(
                "Selected for cancellation review: " + ", ".join(selected_to_cancel)
            )
        else:
            st.info("Select one or more subscriptions to see potential savings.")

    with insights_tab:
        st.markdown('<div class="section-eyebrow">Usage intelligence</div>', unsafe_allow_html=True)
        st.subheader("Usage changes")
        for _, row in data.iterrows():
            change = row["usage_change"]
            if change < 0:
                message = f"Usage decreased by {abs(change):.0f} day(s) compared with last month."
            elif change > 0:
                message = f"Usage increased by {change:.0f} day(s) compared with last month."
            else:
                message = "Usage stayed the same as last month."
            st.markdown(f"- **{row['subscription_name']}:** {message}")

        st.divider()
        st.subheader("Intelligent waste investigation")
        st.write(
            "Usage changes and cost observations below are rule-based explanations "
            "from the data you supplied."
        )
        for _, row in data.iterrows():
            findings, suggestions, annual_cost = build_findings(row)
            with st.expander(f"Investigate {row['subscription_name']}"):
                st.write(f"**Monthly price:** ₹{float(row['monthly_cost']):,.0f}")
                st.write(f"**Annual cost:** ₹{annual_cost:,.0f}")
                st.write(f"**Current usage:** {float(row['usage_days']):.0f} day(s)")
                st.markdown("**Findings**")
                for finding in findings:
                    st.markdown(f"- {finding}")
                st.markdown("**Suggested actions**")
                for suggestion in suggestions or [
                    "Continue monitoring usage and review whether the subscription meets your needs."
                ]:
                    st.markdown(f"- {suggestion}")
                st.caption(
                    "These observations use simple rules; they are not independent "
                    "AI proof that a service is wasteful."
                )

        st.divider()
        st.subheader("Possible category overlap")
        st.write(
            "Multiple subscriptions in the same supported category may offer "
            "overlapping services. Check each provider's features before deciding."
        )
        overlap_found = False
        for category in [
            "Entertainment",
            "Music",
            "Cloud Storage",
            "Education",
            "Software",
        ]:
            matching = data[
                data["category"].astype(str).str.strip().str.lower()
                == category.lower()
            ]
            if len(matching) > 1:
                overlap_found = True
                names_in_category = matching["subscription_name"].astype(str).tolist()
                combined_cost = matching["monthly_cost"].sum()
                st.warning(
                    f"**Possible overlap in {category}:** "
                    f"{', '.join(names_in_category)}. Combined monthly cost: "
                    f"₹{combined_cost:,.0f}."
                )
        if not overlap_found:
            st.success(
                "No category-level overlaps were found. This does not guarantee "
                "that services have no overlapping features."
            )

        st.divider()
        st.subheader("Experimental usage forecast")
        st.caption(
            "This optional LSTM forecast uses the included usage history and is "
            "not validated for real-world use."
        )
        if HISTORY_PATH.exists():
            try:
                history_df = pd.read_csv(HISTORY_PATH)
                expected_history_columns = {
                    "subscription_name",
                    "month",
                    "usage_days",
                }
                missing_history_columns = (
                    expected_history_columns - set(history_df.columns)
                )
                if missing_history_columns:
                    st.error(
                        "Usage history is missing columns: "
                        + ", ".join(sorted(missing_history_columns))
                    )
                else:
                    forecast_names = (
                        history_df["subscription_name"].dropna().unique().tolist()
                    )
                    if not forecast_names:
                        st.warning("No subscriptions were found in usage history.")
                    else:
                        selected_name = st.selectbox(
                            "Select subscription to forecast",
                            forecast_names,
                            key="forecast_subscription",
                        )
                        history_rows = history_df[
                            history_df["subscription_name"] == selected_name
                        ].copy()
                        history_rows["month"] = pd.to_numeric(
                            history_rows["month"], errors="coerce"
                        )
                        history_rows["usage_days"] = pd.to_numeric(
                            history_rows["usage_days"], errors="coerce"
                        )
                        history = (
                            history_rows.dropna(subset=["month", "usage_days"])
                            .sort_values("month")["usage_days"]
                            .to_numpy(dtype=float)
                        )
                        if len(history) < 5:
                            st.warning("At least five months of valid history are required.")
                        else:
                            try:
                                with st.spinner("Preparing the experimental forecast..."):
                                    predicted_days = forecast_usage(tuple(history.tolist()))
                                forecast_metrics = st.columns(2)
                                forecast_metrics[0].metric(
                                    "Predicted usage next month",
                                    f"{predicted_days:.1f} days",
                                )
                                forecast_metrics[1].metric(
                                    "Latest recorded usage",
                                    f"{history[-1]:.0f} days",
                                )
                                history_chart = px.line(
                                    pd.DataFrame(
                                        {
                                            "Month": range(1, len(history) + 1),
                                            "Usage days": history,
                                        }
                                    ),
                                    x="Month",
                                    y="Usage days",
                                    markers=True,
                                    color_discrete_sequence=["#1a9c91"],
                                )
                                st.plotly_chart(
                                    style_chart(history_chart),
                                    width="stretch",
                                )
                                if predicted_days < 5:
                                    st.warning(
                                        "Forecast indicates very low usage. Review whether "
                                        "the subscription is still worth its cost."
                                    )
                                elif predicted_days < 12:
                                    st.info(
                                        "Forecast indicates relatively low usage. "
                                        "Monitor next month's actual usage."
                                    )
                                else:
                                    st.success(
                                        "Forecast indicates moderate or high usage."
                                    )
                            except (ImportError, ModuleNotFoundError) as error:
                                st.error(
                                    "The optional LSTM forecast needs TensorFlow/Keras "
                                    f"installed in this environment: {error}"
                                )
                            except Exception as error:
                                st.error(f"Forecast could not be generated: {error}")
            except (OSError, pd.errors.ParserError, UnicodeDecodeError) as error:
                st.error(f"Usage history could not be read: {error}")
        else:
            st.warning("The optional forecast needs dataset/usage_history.csv.")

        st.divider()
        st.subheader("Personalized recommendations")
        st.write(
            "Suggestions use subscription cost, current and previous usage, and "
            "the model's estimated risk."
        )
        for _, row in data.iterrows():
            name = row["subscription_name"]
            cost = float(row["monthly_cost"])
            current = float(row["usage_days"])
            previous = float(row["previous_usage_days"])
            risk = float(row["waste_risk"])
            annual_cost = cost * 12
            suggestions = []
            if current == 0:
                suggestions.append(
                    "No usage was recorded this month. Check whether you still need this subscription."
                )
            elif current <= 3:
                suggestions.append(
                    "Usage is very low. Compare the subscription's benefits with its monthly cost."
                )
            if previous > 0 and current < previous:
                decrease = (previous - current) / previous * 100
                suggestions.append(
                    f"Usage has fallen by {decrease:.1f}% since the previous month. "
                    "Monitor this trend."
                )
            if cost >= 500:
                suggestions.append(
                    f"This subscription costs ₹{annual_cost:,.0f} per year. "
                    "Review whether the benefits justify the expense."
                )
            if risk >= 80:
                suggestions.append(
                    "The experimental ML model flags this subscription as high risk. "
                    "Review the evidence before deciding."
                )
            if not suggestions:
                suggestions.append(
                    "Usage appears relatively frequent. Continue monitoring it and "
                    "check whether the plan suits your needs."
                )
            with st.expander(f"Recommendations for {name}"):
                st.write(f"**Monthly cost:** ₹{cost:,.0f}")
                st.write(f"**Annual cost:** ₹{annual_cost:,.0f}")
                st.write(f"**Usage this month:** {current:.0f} days")
                for suggestion in suggestions:
                    st.markdown(f"- {suggestion}")
                st.caption(
                    "Suggestions use supplied data and experimental model output; "
                    "they do not guarantee savings."
                )

    with reports_tab:
        st.markdown('<div class="section-eyebrow">Export</div>', unsafe_allow_html=True)
        st.subheader("Detailed analysis report")
        st.write(
            "Review all input fields, model outputs, estimated risk, usage change, "
            "and the monthly cost flagged for review."
        )
        display_data = data.rename(
            columns={
                "subscription_name": "Subscription",
                "category": "Category",
                "monthly_cost": "Monthly Cost (₹)",
                "usage_days": "Usage Days",
                "waste_risk": "Waste Risk (%)",
                "review_cost": "Cost to Review (₹)",
                "usage_change": "Usage Change (Days)",
            }
        )
        st.dataframe(
            display_data,
            width="stretch",
            hide_index=True,
        )
        st.download_button(
            "Download Analysis as PDF",
            data=build_pdf_report(data, total_spending, review_cost),
            file_name="subscription_analysis_report.pdf",
            mime="application/pdf",
            type="primary",
            icon=":material/picture_as_pdf:",
            key="pdf-report-download",
        )
        st.caption(
            "Model limitation: the current model was trained on synthetic labels. "
            "Its scores are experimental estimates, not validated real-world "
            "probabilities. Usage explanations are based on the supplied data."
        )
