@st.cache_resource
def load_model():
    return joblib.load(MODEL_PATH)


@st.cache_resource
def load_icon_catalog():
    if SIMPLE_ICONS is None:
        return {}

    catalog = {}
    ambiguous_names = set()
    for icon in SIMPLE_ICONS.values():
        for label in (icon.slug, icon.title):
            normalized = re.sub(r"[^a-z0-9]", "", label.casefold())
            if not normalized:
                continue
            existing = catalog.get(normalized)
            if existing is not None and existing.slug != icon.slug:
                ambiguous_names.add(normalized)
            else:
                catalog[normalized] = icon

    for normalized in ambiguous_names:
        catalog.pop(normalized, None)
    return catalog


def normalized_service_names(name):
    raw_name = str(name).strip()
    normalized = re.sub(r"[^a-z0-9]", "", raw_name.casefold())
    slugified = re.sub(r"[^a-z0-9]+", "-", raw_name.casefold()).strip("-")
    candidates = []

    domain_text = raw_name.casefold()
    if "://" not in domain_text and re.match(
        r"^(?:www\.)?[a-z0-9.-]+\.[a-z]{2,}(?::\d+)?(?:/.*)?$", domain_text
    ):
        domain_text = "https://" + domain_text
    host = urlsplit(domain_text).hostname or ""
    host_parts = host.removeprefix("www.").split(".")
    common_tlds = {
        "app", "au", "ca", "com", "dev", "edu", "in", "io", "net",
        "org", "tv", "uk",
    }
    if len(host_parts) >= 2 and (
        host_parts[-1] in common_tlds
        or (len(host_parts) >= 3 and host_parts[-1] == "uk" and host_parts[-2] == "co")
    ):
        registrable_label = host_parts[-3] if host_parts[-1] == "uk" and host_parts[-2] == "co" else host_parts[-2]
        candidates.append(re.sub(r"[^a-z0-9]", "", registrable_label))

    candidates.append(normalized)
    candidates.append(slugified)
    for suffix in ("premium", "subscription", "membership", "plan"):
        service_base = re.sub(
            rf"[\s_-]+{suffix}$", "", raw_name, flags=re.IGNORECASE
        )
        if service_base != raw_name:
            candidates.append(re.sub(r"[^a-z0-9]", "", service_base.casefold()))
            candidates.append(
                re.sub(r"[^a-z0-9]+", "-", service_base.casefold()).strip("-")
            )
    return tuple(dict.fromkeys(candidate for candidate in candidates if candidate))


def valid_icon_svg(svg_bytes):
    if not svg_bytes or len(svg_bytes) > 200_000:
        return False
    try:
        root = ET.fromstring(svg_bytes)
    except ET.ParseError:
        return False
    if root.tag.rsplit("}", 1)[-1].lower() != "svg":
        return False
    for element in root.iter():
        if element.tag.rsplit("}", 1)[-1].lower() in {
            "script",
            "foreignobject",
            "iframe",
            "object",
            "embed",
        }:
            return False
        for attribute in element.attrib:
            attribute_name = attribute.rsplit("}", 1)[-1].lower()
            if attribute_name.startswith("on"):
                return False
            if attribute_name == "src":
                return False
            if attribute_name == "href" and not element.attrib[attribute].startswith("#"):
                return False
            if attribute_name == "style" and re.search(
                r"url\s*\(", element.attrib[attribute], flags=re.IGNORECASE
            ):
                return False
    return True


@st.cache_data(ttl=3600, show_spinner=False)
def lookup_iconify_icon(service_name, direct_only=False, search_only=False):
    headers = {"User-Agent": "AI-Subscription-Waste-Detector/1.0"}
    if not search_only:
        slug_variants = tuple(
            dict.fromkeys(
                candidate
                for candidate in (
                    re.sub(r"[^a-z0-9]+", "-", service_name.casefold()).strip("-"),
                    re.sub(r"[^a-z0-9]", "", service_name.casefold()),
                )
                if candidate
            )
        )
        for slug in slug_variants:
            svg_url = f"https://api.iconify.design/logos/{slug}.svg"
            try:
                request = Request(svg_url, headers=headers)
                with urlopen(request, timeout=3) as response:
                    svg_bytes = response.read(200_001)
            except (HTTPException, URLError, TimeoutError, OSError):
                continue
            if valid_icon_svg(svg_bytes):
                return "logos", slug, svg_bytes

    if direct_only:
        return None

    search_url = "https://api.iconify.design/search?" + urlencode(
        {"query": service_name, "limit": 64}
    )
    try:
        request = Request(search_url, headers=headers)
        with urlopen(request, timeout=3) as response:
            search_data = json.loads(response.read(200_000))
    except (
        HTTPException,
        URLError,
        TimeoutError,
        OSError,
        ValueError,
        json.JSONDecodeError,
    ):
        return None

    if not isinstance(search_data, dict) or not isinstance(
        search_data.get("icons"), list
    ):
        return None

    target = re.sub(r"[^a-z0-9]", "", service_name.casefold())
    preferred_collections = (
        "logos",
        "thesvg-color",
        "streamline-color",
        "simple-icons",
        "cib",
        "bxl",
        "fa-brands",
    )
    collection_metadata = search_data.get("collections", {})
    logo_collections = {
        collection
        for collection, metadata in collection_metadata.items()
        if isinstance(metadata, dict)
        and str(metadata.get("category", "")).casefold() == "logos"
        and (
            metadata.get("palette") is True
            or collection in {"logos", "simple-icons", "cib", "bxl", "fa-brands"}
        )
    }
    matches = []
    for result in search_data.get("icons", []):
        collection, separator, slug = result.partition(":")
        if (
            separator
            and (
                collection in preferred_collections
                or collection in logo_collections
            )
            and re.sub(r"[^a-z0-9]", "", slug.casefold()) == target
        ):
            priority = (
                preferred_collections.index(collection)
                if collection in preferred_collections
                else len(preferred_collections)
            )
            matches.append((priority, collection, slug))

    for _, collection, slug in sorted(matches):
        svg_url = f"https://api.iconify.design/{collection}/{slug}.svg"
        try:
            request = Request(svg_url, headers=headers)
            with urlopen(request, timeout=3) as response:
                svg_bytes = response.read(200_001)
        except (HTTPException, URLError, TimeoutError, OSError):
            continue
        if valid_icon_svg(svg_bytes):
            return collection, slug, svg_bytes
    return None


@st.cache_data(show_spinner=False)
def resolve_brand_icon(name):
    candidates = normalized_service_names(name)
    if not candidates:
        return None

    for normalized in candidates:
        remote_icon = lookup_iconify_icon(normalized, direct_only=True)
        if remote_icon is not None:
            _, slug, svg_bytes = remote_icon
            return slug.replace("-", " ").title(), "#51677f", svg_bytes

    for normalized in candidates:
        remote_icon = lookup_iconify_icon(normalized, search_only=True)
        if remote_icon is not None:
            _, slug, svg_bytes = remote_icon
            return slug.replace("-", " ").title(), "#51677f", svg_bytes

    local_catalog = load_icon_catalog()
    for normalized in candidates:
        icon = local_catalog.get(re.sub(r"[^a-z0-9]", "", normalized.casefold()))
        if icon is not None:
            svg_bytes = icon.get_xml_bytes(fill=f"#{icon.hex}")
            if valid_icon_svg(svg_bytes):
                return icon.title, icon.hex, svg_bytes
    return None


def icon_data_uri(svg_bytes):
    encoded_svg = base64.b64encode(svg_bytes).decode("ascii")
    return f"data:image/svg+xml;base64,{encoded_svg}"


def render_subscription_icon_list(data, include_risk=False):
    items = []
    for _, row in data.iterrows():
        name = str(row["subscription_name"])
        escaped_name = html.escape(name)
        brand_icon = resolve_brand_icon(name)
        if brand_icon is None:
            image = (
                '<svg viewBox="0 0 24 24" role="img" aria-label="Subscription">'
                '<rect x="3.5" y="4.5" width="17" height="15" rx="3" '
                'fill="none" stroke="#7890a6" stroke-width="1.7"/>'
                '<path d="M7.5 9h9M7.5 13h5" stroke="#7890a6" '
                'stroke-width="1.7" stroke-linecap="round"/>'
                "</svg>"
            )
            icon_markup = image
        else:
            title, _, svg_bytes = brand_icon
            icon_markup = (
                f'<img src="{icon_data_uri(svg_bytes)}" '
                f'alt="{html.escape(title)}" loading="lazy">'
            )

        details = [
            html.escape(str(row["category"])),
            f"₹{float(row['monthly_cost']):,.0f}/mo",
        ]
        if include_risk and "waste_risk" in row:
            details.append(f"{float(row['waste_risk']):.1f}% estimated risk")
        items.append(
            '<div class="service-icon-card">'
            f'<span class="service-icon">{icon_markup}</span>'
            '<span class="service-icon-copy">'
            f'<strong title="{escaped_name}">{escaped_name}</strong>'
            f'<small>{" · ".join(details)}</small>'
            "</span></div>"
        )

    st.markdown(
        '<div class="service-icon-list">' + "".join(items) + "</div>",
        unsafe_allow_html=True,
    )


def add_service_icons_to_chart(chart, data):
    maximum_cost = max(float(data["monthly_cost"].max()), 1.0)
    images = []
    for _, row in data.iterrows():
        brand_icon = resolve_brand_icon(row["subscription_name"])
        if brand_icon is None:
            continue
        _, _, svg_bytes = brand_icon
        cost = float(row["monthly_cost"])
        images.append(
            {
                "source": icon_data_uri(svg_bytes),
                "xref": "x",
                "yref": "y",
                "x": str(row["subscription_name"]),
                "y": max(cost, maximum_cost * 0.04) + maximum_cost * 0.055,
                "sizex": 0.34,
                "sizey": maximum_cost * 0.09,
                "xanchor": "center",
                "yanchor": "bottom",
                "sizing": "contain",
                "layer": "above",
            }
        )
    if images:
        chart.update_layout(images=images)
        chart.update_yaxes(range=[0, maximum_cost * 1.25])
    return chart


@st.cache_data(show_spinner=False)
def forecast_usage(history_values):
    import tensorflow as tf
    from sklearn.preprocessing import MinMaxScaler
    from tensorflow.keras.layers import Dense, Input, LSTM
    from tensorflow.keras.models import Sequential

    history = np.asarray(history_values, dtype=float)
    window = 3
    scaler = MinMaxScaler()
    scaled = scaler.fit_transform(history.reshape(-1, 1))
    features, targets = [], []

    for index in range(len(scaled) - window):
        features.append(scaled[index:index + window, 0])
        targets.append(scaled[index + window, 0])

    features = np.asarray(features).reshape(-1, window, 1)
    targets = np.asarray(targets)
    tf.keras.utils.set_random_seed(42)

    forecast_model = Sequential(
        [Input(shape=(window, 1)), LSTM(16), Dense(1)]
    )
    forecast_model.compile(optimizer="adam", loss="mse")
    forecast_model.fit(features, targets, epochs=100, verbose=0)
    last_window = scaled[-window:].reshape(1, window, 1)
    forecast_scaled = forecast_model.predict(last_window, verbose=0)
    predicted_days = float(scaler.inverse_transform(forecast_scaled)[0, 0])
    return float(np.clip(predicted_days, 0, 30))


def fingerprint(data):
    return sha256(data.to_csv(index=False).encode("utf-8")).hexdigest()


def validate_input(input_data):
    errors = []
    if input_data.empty:
        return None, ["Add at least one subscription before analysis."]

    missing_columns = [
        column for column in REQUIRED_COLUMNS if column not in input_data.columns
    ]
    if missing_columns:
        return None, ["Missing required columns: " + ", ".join(missing_columns)]

    data = input_data.copy()
    for column in ("subscription_name", "category"):
        data[column] = data[column].astype("string").str.strip()
        invalid_rows = data[column].isna() | data[column].eq("")
        if invalid_rows.any():
            rows = (np.flatnonzero(invalid_rows.to_numpy()) + 1).tolist()
            errors.append(
                f"{column} must be filled in (table row(s): "
                + ", ".join(map(str, rows))
                + ")."
            )

    for column in NUMERIC_COLUMNS:
        original = data[column]
        converted = pd.to_numeric(original, errors="coerce")
        invalid = converted.isna() | ~np.isfinite(converted.fillna(0))
        if invalid.any():
            rows = (np.flatnonzero(invalid.to_numpy()) + 1).tolist()
            errors.append(
                f"{column} must contain valid finite numbers "
                "(table row(s): "
                + ", ".join(map(str, rows))
                + ")."
            )
        data[column] = converted

    if errors:
        return None, errors

    range_checks = [
        (data["monthly_cost"] < 0, "Monthly cost cannot be negative."),
        (
            (data["usage_days"] < 0) | (data["usage_days"] > 31),
            "Usage days must be between 0 and 31.",
        ),
        (data["usage_hours"] < 0, "Usage hours cannot be negative."),
        (
            data["months_subscribed"] < 1,
            "Months subscribed must be at least 1.",
        ),
        (
            (data["previous_usage_days"] < 0)
            | (data["previous_usage_days"] > 31),
            "Previous usage days must be between 0 and 31.",
        ),
    ]
    for invalid, message in range_checks:
        if invalid.any():
            errors.append(message)

    return (None, errors) if errors else (data, [])


def prepare_model_input(data):
    return pd.DataFrame(
        {
            "monthly_cost": data["monthly_cost"],
            "usage_days": data["usage_days"],
            "usage_hours": data["usage_hours"],
            "months_subscribed": data["months_subscribed"],
            "previous_usage_days": data["previous_usage_days"],
            "category": data["category"].astype(str),
            "usage_percentage": data["usage_days"] / 30 * 100,
            "usage_change": data["usage_days"]
            - data["previous_usage_days"],
        }
    )


def style_chart(chart):
    chart.update_layout(
        template="plotly_white",
        paper_bgcolor="rgba(0,0,0,0)",
        plot_bgcolor="rgba(0,0,0,0)",
        font_family="Aptos, Segoe UI, sans-serif",
        margin=dict(l=12, r=12, t=38, b=10),
        legend_title_text="",
        height=310,
    )
    return chart


def build_findings(row):
    current_days = float(row["usage_days"])
    previous_days = float(row["previous_usage_days"])
    monthly_cost = float(row["monthly_cost"])
    findings, recommendations = [], []

    if previous_days > 0 and current_days < previous_days:
        decrease = (previous_days - current_days) / previous_days * 100
        findings.append(
            f"Usage decreased by {decrease:.1f}% compared with the previous month."
        )
        recommendations.append("Check whether your usage is likely to remain low.")
    elif current_days > previous_days:
        findings.append(
            f"Usage increased by {current_days - previous_days:.0f} day(s)."
        )
    else:
        findings.append("Usage has not decreased compared with last month.")

    if current_days == 0:
        findings.append("No usage was recorded this month.")
        recommendations.append("Consider pausing or cancelling if you no longer need it.")
    elif current_days <= 3:
        findings.append(
            f"The subscription was used on only {current_days:.0f} day(s) this month."
        )
        recommendations.append("Compare the cost with how much you actually use it.")
    elif current_days >= 20:
        findings.append("The subscription was used frequently this month.")

    annual_cost = monthly_cost * 12
    if monthly_cost >= 500:
        findings.append(
            f"The annual cost is ₹{annual_cost:,.0f}, "
            "so reviewing its value may be worthwhile."
        )
    return findings, recommendations, annual_cost


def render_about():
    st.markdown(
        """
        <div class="hero">
          <div class="hero-kicker">Project brief</div>
          <h1>About the project</h1>
          <p>An analytics dashboard for reviewing subscription usage, spending, and possible waste—without automating cancellation decisions.</p>
        </div>
        """,
        unsafe_allow_html=True,
    )

    st.markdown('<div class="section-eyebrow">Purpose</div>', unsafe_allow_html=True)
    st.header("Project overview & objectives")
    st.write(
        "AI Subscription Waste Detector combines subscription details and usage "
        "patterns to help people spot services that may be worth reviewing."
    )
    objectives = st.columns(3)
    for column, title, body in zip(
        objectives,
        ["Understand spend", "Review usage", "Support decisions"],
        [
            "Summarize recurring costs and estimate a steady-price spending baseline.",
            "Highlight low or declining usage and possible category-level overlap.",
            "Present model estimates and practical recommendations for human review.",
        ],
    ):
        with column:
            st.markdown(
                f'<div class="soft-card"><strong>{title}</strong><p>{body}</p></div>',
                unsafe_allow_html=True,
            )

    st.divider()
    left, right = st.columns(2)
    with left:
        st.subheader("Technologies")
        st.markdown(
            "- **Python** for the application and analysis\n"
            "- **Streamlit** for the interactive dashboard\n"
            "- **Pandas and NumPy** for data processing\n"
            "- **Scikit-learn** and a trained **Random Forest** pipeline\n"
            "- **Plotly** for interactive charts\n"
            "- **Simple Icons** local catalog for offline brand marks\n"
            "- **TensorFlow/Keras** for an experimental usage forecast\n"
            "- **CSV** files for subscription and usage-history data"
        )
        st.subheader("Key features")
        st.markdown(
            "- CSV import and editable subscription data\n"
            "- Model predictions, risk scores, and review-cost estimates\n"
            "- Spending baseline and cancellation savings simulator\n"
            "- Usage trends, category overlap, and recommendations\n"
            "- Downloadable analysis report"
        )
    with right:
        st.subheader("How the machine-learning analysis works")
        st.markdown(
            "The app derives usage percentage and month-over-month usage change, "
            "then sends those values together with the supplied cost, usage, "
            "tenure, and category features to the saved Random Forest pipeline. "
            "Its prediction and class-1 score are displayed as an assessment "
            "and risk estimate."
        )
        st.subheader("Limitations")
        st.warning(
            "The training labels are synthetic, and model performance has not "
            "been established on representative real-world subscription data. "
            "Risk scores are estimates—not guaranteed probabilities or proof "
            "of waste. The spending forecast assumes current prices remain "
            "unchanged; the LSTM forecast is experimental and uses limited "
            "history. Recommendations do not cancel services or guarantee savings."
        )
        st.caption(
            "Brand marks are matched exactly against the local Simple Icons "
            "catalog first. If no local match is found, the app may send that "
            "subscription name (or its explicitly entered domain) to Iconify's "
            "search API; only an exact logo-slug match is accepted. Iconify "
            "lookups are cached for one hour. If the service is unavailable, "
            "the name is unmatched, or the app is offline, a neutral icon is shown."
        )
    st.caption(
        "The application is intended to support review and learning, not to "
        "replace personal judgment."
    )


def clear_user_session():
    user_state_keys = (
        "auth_user_id",
        "auth_username",
        "draft_data",
        "upload_signature",
        "upload_error",
        "analysis_data",
        "analysis_fingerprint",
        "subscription_data_fingerprint",
        "subscription_editor",
        "subscription_csv_upload",
        "cancellation_simulator",
        "forecast_subscription",
        "restore_sample_data",
    )
    for key in user_state_keys:
        st.session_state.pop(key, None)


def start_user_session(user_id, username):
    clear_user_session()
    saved_data = load_subscriptions(user_id)
    st.session_state.auth_user_id = user_id
    st.session_state.auth_username = username
    st.session_state.draft_data = (
        saved_data if saved_data is not None else DEFAULT_DATA.copy()
    )
    st.session_state.upload_signature = None
    st.session_state.upload_error = None
    st.session_state.analysis_data = None
    st.session_state.analysis_fingerprint = None
    st.session_state.subscription_data_fingerprint = fingerprint(
        st.session_state.draft_data
    )


