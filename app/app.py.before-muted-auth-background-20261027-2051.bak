def build_pdf_report(data, total_spending, review_cost):
    buffer = BytesIO()
    page_size = landscape(A4)
    document = SimpleDocTemplate(
        buffer,
        pagesize=page_size,
        leftMargin=0.35 * inch,
        rightMargin=0.35 * inch,
        topMargin=0.45 * inch,
        bottomMargin=0.45 * inch,
        title="Subscription Waste Analysis Report",
    )

    regular_font = "DejaVuSans"
    bold_font = "DejaVuSans-Bold"
    if regular_font not in pdfmetrics.getRegisteredFontNames():
        pdfmetrics.registerFont(
            TTFont(regular_font, str(ROOT / "assets" / "fonts" / "DejaVuSans.ttf"))
        )
    if bold_font not in pdfmetrics.getRegisteredFontNames():
        pdfmetrics.registerFont(
            TTFont(
                bold_font,
                str(ROOT / "assets" / "fonts" / "DejaVuSans-Bold.ttf"),
            )
        )
    pdfmetrics.registerFontFamily(
        regular_font,
        normal=regular_font,
        bold=bold_font,
        italic=regular_font,
        boldItalic=bold_font,
    )

    styles = getSampleStyleSheet()
    title_style = ParagraphStyle(
        "ReportTitle",
        parent=styles["Title"],
        fontName=bold_font,
        fontSize=18,
        leading=22,
        textColor=colors.HexColor("#17324D"),
        alignment=TA_LEFT,
        spaceAfter=4,
    )
    body_style = ParagraphStyle(
        "ReportBody",
        parent=styles["BodyText"],
        fontName=regular_font,
        fontSize=8,
        leading=10,
        textColor=colors.HexColor("#263746"),
    )
    header_style = ParagraphStyle(
        "ReportTableHeader",
        parent=body_style,
        fontName=bold_font,
        textColor=colors.white,
        fontSize=7.5,
        leading=9,
    )
    date_style = ParagraphStyle(
        "ReportDate",
        parent=body_style,
        textColor=colors.HexColor("#5D6B78"),
        spaceAfter=12,
    )

    def format_value(value):
        if pd.isna(value):
            return "-"
        if isinstance(value, (int, float, np.integer, np.floating)):
            return f"{float(value):g}"
        return str(value)

    columns = [
        ("Subscription", "subscription_name"),
        ("Category", "category"),
        ("Monthly Cost (₹)", "monthly_cost"),
        ("Usage Days", "usage_days"),
        ("Usage Hours", "usage_hours"),
        ("Months Subscribed", "months_subscribed"),
        ("Previous Usage Days", "previous_usage_days"),
        ("AI Waste Risk (%)", "waste_risk"),
        ("Prediction", "prediction"),
        ("Usage Change (Days)", "usage_change"),
        ("Cost to Review (₹)", "review_cost"),
    ]
    table_rows = [[Paragraph(label, header_style) for label, _ in columns]]
    for _, row in data.iterrows():
        cells = []
        for _, key in columns:
            value = row.get(key)
            if key == "monthly_cost":
                rendered_value = f"₹{float(value):,.0f}"
            elif key == "review_cost":
                rendered_value = f"₹{float(value):,.0f}"
            elif key == "waste_risk":
                rendered_value = f"{float(value):.1f}%"
            elif key == "usage_change":
                rendered_value = f"{float(value):+.1f}"
            else:
                rendered_value = format_value(value)
            cells.append(Paragraph(html.escape(rendered_value), body_style))
        table_rows.append(cells)

    report_table = Table(
        table_rows,
        colWidths=[
            1.25 * inch,
            0.90 * inch,
            0.95 * inch,
            0.65 * inch,
            0.70 * inch,
            0.95 * inch,
            0.95 * inch,
            0.90 * inch,
            1.25 * inch,
            0.90 * inch,
            1.00 * inch,
        ],
        repeatRows=1,
        hAlign="LEFT",
    )
    report_table.setStyle(
        TableStyle(
            [
                ("FONTNAME", (0, 0), (-1, -1), regular_font),
                ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#17324D")),
                ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
                ("VALIGN", (0, 0), (-1, -1), "TOP"),
                ("GRID", (0, 0), (-1, -1), 0.35, colors.HexColor("#D6DEE6")),
                (
                    "ROWBACKGROUNDS",
                    (0, 1),
                    (-1, -1),
                    [colors.white, colors.HexColor("#F3F7FA")],
                ),
                ("LEFTPADDING", (0, 0), (-1, -1), 5),
                ("RIGHTPADDING", (0, 0), (-1, -1), 5),
                ("TOPPADDING", (0, 0), (-1, -1), 6),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 6),
            ]
        )
    )

    generated_at = datetime.now().strftime("%d %B %Y, %H:%M")
    summary = Table(
        [[
            Paragraph(f"<b>Monthly spending</b><br/>₹{total_spending:,.0f}", body_style),
            Paragraph(f"<b>Total subscriptions</b><br/>{len(data)}", body_style),
            Paragraph(
                f"<b>Estimated cost flagged for review</b><br/>₹{review_cost:,.0f}",
                body_style,
            ),
        ]],
        colWidths=[3.5 * inch, 2.5 * inch, 4.0 * inch],
    )
    summary.setStyle(
        TableStyle(
            [
                ("FONTNAME", (0, 0), (-1, -1), regular_font),
                ("BACKGROUND", (0, 0), (-1, -1), colors.HexColor("#EEF4F8")),
                ("BOX", (0, 0), (-1, -1), 0.5, colors.HexColor("#D6DEE6")),
                ("INNERGRID", (0, 0), (-1, -1), 0.5, colors.HexColor("#D6DEE6")),
                ("VALIGN", (0, 0), (-1, -1), "TOP"),
                ("LEFTPADDING", (0, 0), (-1, -1), 9),
                ("RIGHTPADDING", (0, 0), (-1, -1), 9),
                ("TOPPADDING", (0, 0), (-1, -1), 8),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 8),
            ]
        )
    )

    def add_page_number(canvas, doc):
        canvas.saveState()
        canvas.setFont(regular_font, 8)
        canvas.setFillColor(colors.HexColor("#5D6B78"))
        canvas.drawRightString(
            page_size[0] - 0.35 * inch, 0.22 * inch, f"Page {doc.page}"
        )
        canvas.restoreState()

    story = [
        Paragraph("Subscription Waste Analysis Report", title_style),
        Paragraph(f"Generated: {generated_at}", date_style),
        summary,
        Spacer(1, 14),
        report_table,
    ]
    document.build(story, onFirstPage=add_page_number, onLaterPages=add_page_number)
    return buffer.getvalue()


